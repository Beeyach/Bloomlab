{
  "name": "@bloomlab/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bloomlab web application (React + Vite, served by the Cloudflare Worker)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@bloomlab/design-system": "*",
    "@bloomlab/shared": "*",
    "@bloomlab/simulator-core": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  }
}
