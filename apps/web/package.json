{
  "name": "@bloomlab/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bloomlab web application (React + Vite, served by the Cloudflare Worker)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/check-browser-secrets.mjs",
    "build:preview": "vite build --mode preview && node ../../scripts/check-browser-secrets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@bloomlab/content-schema": "*",
    "@bloomlab/design-system": "*",
    "@bloomlab/exercise-engine": "*",
    "@bloomlab/mastery-engine": "*",
    "@bloomlab/shared": "*",
    "@bloomlab/simulator-core": "*",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
