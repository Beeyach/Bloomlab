{
  "name": "bloomlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bloomlab — mastery-based funnel and GoHighLevel training simulator",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev -w @bloomlab/web",
    "build": "npm run build -w @bloomlab/web",
    "preview": "npm run preview -w @bloomlab/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:docs": "node scripts/validate-requirements.mjs",
    "security:source": "node scripts/check-source-secrets.mjs",
    "security:cloud": "node scripts/check-cloud-privacy.mjs",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:adversarial && npm run validate:docs && npm run security:source && npm run content:check && npm run content:freshness && npm run voice:check && npm run build && npm run test:a11y",
    "test:a11y": "node scripts/review/a11y-probe.mjs",
    "test:adversarial": "node scripts/adversarial.mjs",
    "review:capture": "node scripts/review/capture.mjs",
    "review:holo": "node scripts/review/holo-probe.mjs",
    "review:offline": "node scripts/review/offline-probe.mjs",
    "review:sync": "node scripts/review/sync-probe.mjs",
    "review:voice": "node scripts/review/voice-probe.mjs",
    "voice:generate": "node scripts/voice-assets.mjs generate",
    "voice:promote": "node scripts/voice-assets.mjs promote",
    "voice:index": "node scripts/voice-assets.mjs index",
    "voice:check": "node scripts/voice-assets.mjs check",
    "content:build": "node scripts/content.mjs build",
    "content:check": "node scripts/content.mjs check",
    "content:lock": "node scripts/content.mjs lock",
    "content:freshness": "node scripts/registry-freshness.mjs",
    "review:learning": "node scripts/review/learning-probe.mjs",
    "review:keyboard": "node scripts/review/keyboard-probe.mjs",
    "review:touch": "node scripts/review/touch-probe.mjs",
    "review:exercise": "node scripts/review/exercise-probe.mjs",
    "review:academy": "node scripts/review/academy-probe.mjs",
    "review:simulator": "node scripts/review/simulator-probe.mjs",
    "review:holo-touch": "node scripts/review/holo-touch-probe.mjs",
    "review:crm": "node scripts/review/crm-probe.mjs",
    "review:crm-review": "node scripts/review/crm-review-probe.mjs",
    "review:rail": "node scripts/review/rail-probe.mjs",
    "review:workflow": "node scripts/review/workflow-probe.mjs",
    "review:funnel": "node scripts/review/funnel-probe.mjs",
    "review:calendar": "node scripts/review/calendar-probe.mjs",
    "review:reporting": "node scripts/review/reporting-probe.mjs",
    "review:incident": "node scripts/review/incident-probe.mjs",
    "review:sales": "node scripts/review/sales-probe.mjs",
    "review:negotiation": "node scripts/review/negotiation-probe.mjs",
    "review:pricing": "node scripts/review/pricing-probe.mjs",
    "review:call": "node scripts/review/call-probe.mjs",
    "review:fieldwork": "node scripts/review/fieldwork-probe.mjs",
    "review:portfolio": "node scripts/review/portfolio-probe.mjs",
    "review:navigation": "node scripts/review/navigation-probe.mjs",
    "review:sidebar-resize": "node scripts/review/sidebar-resize-probe.mjs",
    "review:ai-off": "node scripts/review/ai-off-suite.mjs",
    "review:binary-recovery": "node scripts/review/binary-recovery-probe.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.4.1",
    "axe-core": "4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
