{
  "name": "bloomlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bloomlab — mastery-based funnel and GoHighLevel training simulator",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev -w @bloomlab/web",
    "build": "npm run build -w @bloomlab/web",
    "preview": "npm run preview -w @bloomlab/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:docs": "node scripts/validate-requirements.mjs",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run validate:docs && npm run build",
    "review:capture": "node scripts/review/capture.mjs",
    "review:holo": "node scripts/review/holo-probe.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
